generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  ACTIVE
  INACTIVE
  HOLD
  SUSPENDED
  BLOCKED
  DELETED
  EXPIRED
  USED
}

enum UserType {
  INDIVIDUAL
  ORGANISATION
}

enum RoleType {
  ADMIN
  GENERAL
}

model GlobalPermissionMaster {
  id             Int      @id @default(autoincrement())
  permissionName String
  parent         String
  status         Status   @default(ACTIVE)
  createdBy      String   @default("System")
  updatedBy      String   @default("System")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  PackagePermissions PackagePermissions[]

  @@unique([permissionName, parent])
  @@map("global_permission_master")
}

model Packages {
  id          Int      @id @default(autoincrement())
  name        String
  price       String
  packageData Json
  limits      Json?
  isMaster    Boolean  @default(false)
  status      Status   @default(ACTIVE)
  createdBy   String   @default("System")
  updatedBy   String   @default("System")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant             Tenants[]
  packagePermissions PackagePermissions[]
  Users              Users[]

  @@map("packages")
}

model PackagePermissions {
  id            Int      @id @default(autoincrement())
  packageId     Int
  permissionsId Int
  status        Status   @default(ACTIVE)
  createdBy     String   @default("System")
  updatedBy     String   @default("System")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  package                 Packages               @relation(fields: [packageId], references: [id])
  globalPermissionsMaster GlobalPermissionMaster @relation(fields: [permissionsId], references: [id])

  @@map("package_permissions")
}

model Tenants {
  id        Int      @id @default(autoincrement())
  name      String
  logo      String?
  packageId Int
  status    Status   @default(ACTIVE)
  createdBy String   @default("System")
  updatedBy String   @default("System")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  package   Packages    @relation(fields: [packageId], references: [id])
  role      Roles[]
  users     Users[]
  urlMapper UrlMapper[]

  @@map("tenants")
}

model Roles {
  id        Int      @id @default(autoincrement())
  roleName  String
  roleType  RoleType
  tenantId  Int
  status    Status   @default(ACTIVE)
  createdBy String   @default("System")
  updatedBy String   @default("System")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenants     @relation(fields: [tenantId], references: [id])
  user      Users[]
  urlMapper UrlMapper[]

  @@map("roles")
}

model Users {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  username  String?  @unique
  picture   String?
  password  String?
  userType  UserType @default(INDIVIDUAL)
  roleId    Int?
  tenantId  Int?
  packageId Int?
  status    Status   @default(ACTIVE)
  createdBy String   @default("System")
  updatedBy String   @default("System")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role      Roles?      @relation(fields: [roleId], references: [id])
  tenant    Tenants?    @relation(fields: [tenantId], references: [id])
  packages  Packages?   @relation(fields: [packageId], references: [id])
  urlMapper UrlMapper[]

  @@map("users")
}

model Otp {
  id        Int      @id @default(autoincrement())
  email     String
  otp       String
  otpReason String
  attempts  Int      @default(0)
  isUsed    Boolean
  status    Status   @default(ACTIVE)
  createdBy String   @default("System")
  updatedBy String   @default("System")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiredAt DateTime

  @@map("otp")
}

model OtpCount {
  id        Int      @id @default(autoincrement())
  email     String
  otp       String
  otpReason String
  otpCount  Int
  status    Status   @default(ACTIVE)
  createdBy String   @default("System")
  updatedBy String   @default("System")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("otp_count")
}

model UrlMapper {
  id               Int      @id @default(autoincrement())
  fileId           String   @unique
  originalUrl      String
  mapUrl           String
  fileName         String
  fileSize         String
  fileType         String
  originalFileName String
  originalFileSize String
  mimeType         String
  userId           Int?
  roleId           Int?
  tenantId         Int?
  status           Status   @default(ACTIVE)
  createdBy        Int?
  updatedBy        Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  roles   Roles?   @relation(fields: [roleId], references: [id])
  users   Users?   @relation(fields: [userId], references: [id])
  tenants Tenants? @relation(fields: [tenantId], references: [id])

  @@map("url_mapper")
}

model LinkDetails {
  id          Int      @id @default(autoincrement())
  linkId      String   @unique
  programCode String
  linkData    Json
  status      Status   @default(ACTIVE)
  createdBy   String   @default("System")
  updatedBy   String   @default("System")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  expiredAt   DateTime

  @@map("link_details")
}

model WhitelistEmail {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  status    Status   @default(ACTIVE)
  createdBy String   @default("System")
  updatedBy String   @default("System")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("whitelist_email")
}
