generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  ACTIVE
  INACTIVE
  HOLD
  SUSPENDED
  BLOCKED
  DELETED
}

enum UserType {
  INDIVIDUAL
  ORGANISATION
}

enum RoleType {
  ADMIN
  GENERAL
}

model GlobalPermissionMaster {
  id             String   @id @default(uuid())
  permissionName String
  parent         String
  packageId      String?
  status         Status   @default(ACTIVE)
  createdBy      String   @default("System")
  updatedBy      String   @default("System")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  package                 Packages?                 @relation(fields: [packageId], references: [id])
  globalTenantPermissions GlobalTenantPermissions[]
  globalUserPermissions   GlobalUserPermissions[]

  @@unique([permissionName, parent, packageId])
  @@map("global_permission_master")
}

model GlobalTenantPermissions {
  id            String   @id @default(uuid())
  tenantId      String
  permissionsId String
  packageId     String?
  status        Status   @default(ACTIVE)
  createdBy     String   @default("System")
  updatedBy     String   @default("System")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant     Tenants                @relation(fields: [tenantId], references: [id])
  permission GlobalPermissionMaster @relation(fields: [permissionsId], references: [id])

  globalRolePermissions GlobalRolePermissions[]

  @@map("global_tenant_permissions")
}

model Packages {
  id          String   @id @default(uuid())
  name        String
  price       String
  packageData Json
  limits      Json?
  status      Status   @default(ACTIVE)
  createdBy   String   @default("System")
  updatedBy   String   @default("System")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant                 Tenants[]
  globalPermissionMaster GlobalPermissionMaster[]

  @@map("packages")
}

model Tenants {
  id        String   @id @default(uuid())
  name      String
  logo      String?
  packageId String
  status    Status   @default(ACTIVE)
  createdBy String   @default("System")
  updatedBy String   @default("System")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  package                 Packages                  @relation(fields: [packageId], references: [id])
  role                    Roles[]
  users                   Users[]
  globalTenantPermissions GlobalTenantPermissions[]
  urlMapper               UrlMapper[]

  @@map("tenants")
}

model Roles {
  id        String   @id @default(uuid())
  roleName  String
  roleType  RoleType
  tenantId  String
  status    Status   @default(ACTIVE)
  createdBy String   @default("System")
  updatedBy String   @default("System")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant                Tenants                 @relation(fields: [tenantId], references: [id])
  user                  Users[]
  globalRolePermissions GlobalRolePermissions[]
  urlMapper             UrlMapper[]

  @@map("roles")
}

model Users {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  username  String?  @unique
  picture   String?
  password  String?
  userType  UserType @default(INDIVIDUAL)
  roleId    String?
  tenantId  String?
  status    Status   @default(ACTIVE)
  createdBy String   @default("System")
  updatedBy String   @default("System")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role                  Roles?                  @relation(fields: [roleId], references: [id])
  tenant                Tenants?                @relation(fields: [tenantId], references: [id])
  globalUserPermissions GlobalUserPermissions[]
  urlMapper             UrlMapper[]

  @@map("users")
}

model GlobalRolePermissions {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  status       Status   @default(ACTIVE)
  createdBy    String   @default("System")
  updatedBy    String   @default("System")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role                   Roles                   @relation(fields: [roleId], references: [id])
  globalTenantPermission GlobalTenantPermissions @relation(fields: [permissionId], references: [id])

  @@map("global_role_permissions")
}

model GlobalUserPermissions {
  id           String   @id @default(uuid())
  userId       String
  permissionId String
  status       Status   @default(ACTIVE)
  createdBy    String   @default("System")
  updatedBy    String   @default("System")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  globalPermissionMaster GlobalPermissionMaster @relation(fields: [permissionId], references: [id])
  users                  Users                  @relation(fields: [userId], references: [id])

  @@map("global_user_permissions")
}

model Otp {
  id        String   @id @default(uuid())
  email     String
  otp       String
  otpReason String
  attempts  Int      @default(0)
  isUsed    Boolean
  status    Status   @default(ACTIVE)
  createdBy String   @default("System")
  updatedBy String   @default("System")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiredAt DateTime

  @@map("otp")
}

model OtpCount {
  id        String   @id @default(uuid())
  email     String
  otp       String
  otpReason String
  otpCount  Int
  status    Status   @default(ACTIVE)
  createdBy String   @default("System")
  updatedBy String   @default("System")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("otp_count")
}

model UrlMapper {
  id               String   @id @default(uuid())
  fileId           String   @unique
  originalUrl      String
  mapUrl           String
  fileName         String
  fileSize         String
  fileType         String
  originalFileName String
  originalFileSize String
  mimeType         String
  userId           String?
  roleId           String?
  tenantId         String?
  status           Status   @default(ACTIVE)
  createdBy        String?
  updatedBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  roles   Roles?   @relation(fields: [roleId], references: [id])
  users   Users?   @relation(fields: [userId], references: [id])
  tenants Tenants? @relation(fields: [tenantId], references: [id])

  @@map("url_mapper")
}

model LinkDetails {
  id        String   @id @default(uuid())
  linkId    String
  linkData  Json
  status    Status   @default(ACTIVE)
  createdBy String   @default("System")
  updatedBy String   @default("System")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiredAt DateTime

  @@map("link_details")
}

model WhitelistEmail {
  id        String   @id @default(uuid())
  email     String   @unique
  status    Status   @default(ACTIVE)
  createdBy String   @default("System")
  updatedBy String   @default("System")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("whitelist_email")
}
